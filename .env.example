# Caller-supplied connections only. Never point tests at a live database.
CONTENT_DATABASE_URL=
CONTENT_MIGRATION_DATABASE_URL=
CONTENT_SCHEMA=cms_example
CONTENT_INSTALLATION_ID=example
CONTENT_PUBLICATION_ID=example
CONTENT_SITE_URL=https://example.invalid
# Optional canonical frontend base for imported pages, when different from posts.
CONTENT_PAGE_URL=
# Public discovery metadata; never put secrets here. Logo is optional.
CONTENT_SITE_TITLE=Content
CONTENT_SITE_DESCRIPTION=
CONTENT_SITE_LOGO=
CONTENT_LISTEN=127.0.0.1:8080
# Supply existing scoped keys; none are generated automatically.
CONTENT_ADMIN_KEY=
CONTENT_CONTENT_KEY=

# Both flags default to false. No historical posts/outbox are enrolled.
# Enrollment is only for posts created while the serve process enables this flag.
CONTENT_PUBLISHING_ENROLL_NEW=false
CONTENT_PUBLISHING_DESTINATION=
CONTENT_PUBLISHING_SOURCE=
# The separate `content deliver` worker uses its own caller-supplied DB role.
CONTENT_PUBLISHING_DELIVERY_ENABLED=false
CONTENT_DELIVERY_DATABASE_URL=
# Full /internal/v2/events URL: HTTPS, or HTTP on literal loopback/localhost.
CONTENT_PUBLISHING_ENDPOINT=
CONTENT_PUBLISHING_TOKEN=

# Optional public attribution, all three together. Stable ID is caller-supplied.
# Required for the measured iA new-draft response profile; no staff role implied.
CONTENT_AUTHOR_ID=
CONTENT_AUTHOR_NAME=
CONTENT_AUTHOR_SLUG=
# Optional native browser review; separate operator auth, all three together.
# HTTPS root origin, except loopback HTTP for disposable local tests.
CONTENT_REVIEW_ORIGIN=
# Explicit former HTTPS origins allowed during a hostname transition (max 8).
CONTENT_REVIEW_ORIGIN_ALIASES=
CONTENT_REVIEW_USERNAME=
CONTENT_REVIEW_PASSWORD_HASH=

# Optional image storage; disabled when backend is empty. See docs/media.md.
# filesystem for a dedicated private development directory, or s3.
CONTENT_MEDIA_BACKEND=
CONTENT_MEDIA_ORIGIN=
# Keep old image URLs attached without rewriting saved content (max 8).
CONTENT_MEDIA_ORIGIN_ALIASES=
CONTENT_MEDIA_DIRECTORY=
# path (default) or virtual-host, exactly as required by the provider.
CONTENT_MEDIA_S3_URL_STYLE=
CONTENT_MEDIA_S3_ENDPOINT=
CONTENT_MEDIA_S3_REGION=
CONTENT_MEDIA_S3_BUCKET=
CONTENT_MEDIA_S3_ACCESS_KEY=
CONTENT_MEDIA_S3_SECRET_KEY=
CONTENT_MEDIA_S3_SESSION_TOKEN=
# Separate restricted maintenance role, used only by `content media-cleanup`.
CONTENT_MEDIA_CLEANUP_DATABASE_URL=

# Durable scheduling inside content serve; migrate and grant tables first.
# UI times are explicitly UTC. No jobs are inferred from imported timestamps.
CONTENT_SCHEDULER_ENABLED=false
# Enable only after the consuming website resolves aliases; otherwise keep warning.
CONTENT_SLUG_REDIRECTS_ENABLED=false
