FROM golang:1.26.4-bookworm@sha256:b305420a68d0f229d91eb3b3ed9e519fcf2cf5461da4bef997bf927e8c0bfd2b AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/content ./cmd/content
FROM node@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS dependencies
WORKDIR /app
COPY internal/activitypub/package.json internal/activitypub/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
FROM dependencies AS runtime-source
COPY internal/activitypub/src ./src
RUN rm src/migrate.ts src/import-identity.ts
FROM dependencies AS runtime
COPY --from=runtime-source /app/src ./src
COPY --from=go-build /out/content /app/content-delivery
COPY internal/activitypub/deploy/integrated/entrypoint.ts internal/activitypub/deploy/integrated/delivery-child.mjs ./deploy/integrated/
USER node
ENV HOST=0.0.0.0 PORT=3000 NODE_ENV=production FEDERATION_ENABLED=false
EXPOSE 3000
CMD ["node", "deploy/integrated/entrypoint.ts"]
