          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "type": {
          "type": "string",
          "const": "content.published"
        },
        "document": {
          "type": "object",
          "properties": {
            "visibility": {
              "type": "string",
              "const": "public"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^(?![\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*$)[^\\u0000]*$",
              "description": "1..255 Unicode code points; not solely Unicode White_Space; no NUL. Combining marks count separately. Preserved without normalization or truncation."
            },
            "html": {
              "type": "string",
              "maxLength": 1048576
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "published_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            },
            "tags": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Exact authored public label, not an internal # tag; no normalization or truncation."
                  },
                  "href": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  }
                },
                "required": [
                  "name",
                  "href"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "visibility",
            "title",
            "html",
            "url",
            "published_at"
          ],
          "additionalProperties": false
        }
      },
